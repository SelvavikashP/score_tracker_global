# Flask Application Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=generate_a_random_64_character_hex_secret_here

# Database Configuration (PostgreSQL URL for production, leave empty for local SQLite)
DATABASE_URL=postgresql://username:password@localhost:5432/score_tracker_db

# Initial Admin Credentials (Used ONLY on initial database creation if no admin exists)
INITIAL_ADMIN_EMAIL=admin@yourinstitution.edu
INITIAL_ADMIN_USERNAME=portal_admin
INITIAL_ADMIN_PASSWORD=SetAStrongSecurePasswordHere123!

# Security & Session Settings
SESSION_COOKIE_SECURE=False
SYNC_CACHE_MINUTES=30
MAX_CONCURRENT_SYNC_WORKERS=4

# =============================================================================
# Email Notifications & SMTP Settings
# =============================================================================
# Set to True only if you want to require 6-digit OTP verification on signup.
# By default (False), users are immediately activated and sent an account details email.
REQUIRE_EMAIL_VERIFICATION=False
OTP_EXPIRE_MINUTES=10

# Live SMTP Configuration (Required to send real emails to Gmail, Outlook, etc.)
# If left empty, the application runs in DEV MODE and logs email summaries to the console.
#
# --- GMAIL SMTP EXAMPLE ---
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in the values below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=your_email@gmail.com

# Optional: Platform API Tokens (if future platform endpoints require authenticated API access)
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=

