# Flask Application Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=generate_a_random_64_character_hex_secret_here
APP_BASE_URL=https://score-tracker-z8a8.onrender.com

# MongoDB Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/
MONGODB_DB=score_tracker

# Default Student Password for staff provisioning & bulk import
DEFAULT_STUDENT_PASSWORD=Student@123

# Initial Admin Credentials (Used ONLY on initial database creation if no admin exists)
INITIAL_ADMIN_EMAIL=admin@yourinstitution.edu
INITIAL_ADMIN_USERNAME=portal_admin
INITIAL_ADMIN_PASSWORD=SetAStrongSecurePasswordHere123!
INITIAL_ADMIN_FULLNAME=System Admin

# Security & Session Settings
SESSION_COOKIE_SECURE=True
SYNC_CACHE_MINUTES=30
MAX_CONCURRENT_SYNC_WORKERS=4
ENABLE_DEMO_DATA=False

# Email Notifications & SMTP Settings
REQUIRE_EMAIL_VERIFICATION=False
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=15

# Live SMTP Configuration (Gmail, SendGrid, Amazon SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=your_email@gmail.com
